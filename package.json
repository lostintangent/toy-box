{
  "name": "@lostintangent/toy-box",
  "version": "0.1.15",
  "description": "Your personal coding agent server",
  "bin": {
    "toy-box": "toy-box"
  },
  "files": [
    "toy-box"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "TERMINAL_WS_PORT=3101 bun run --parallel \"dev:*\"",
    "dev:app": "vite dev --port 3100",
    "dev:terminal": "bun run src/server/terminal/dev.ts",
    "build": "vite build",
    "build:cli": "bun run build && bun run cli/build.ts",
    "check": "tsc",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepare": "lefthook install"
  },
