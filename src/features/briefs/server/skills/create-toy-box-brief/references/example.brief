{
  "title": "Let ordinary tools share message bodies",
  "sections": [
    {
      "id": "research-findings",
      "title": "Where tool rendering already lives",
      "purpose": "Preserve the current ownership and rendering facts that shape the shared-body boundary.",
      "kind": "findings",
      "collapsed": true,
      "sourcePolicy": "code",
      "items": [
        {
          "id": "finding-card-owner",
          "statement": "ToolCallMessage already owns the common card frame, status, disclosure, and actions.",
          "whyItMatters": "A shared body can remain content inside that lifecycle instead of creating a second card owner.",
          "sources": [
            "src/features/sessions/components/transcript/messages/tools/ToolCallMessage.tsx#ToolCallMessage"
          ],
          "exhibit": {
            "id": "current-card-ownership",
            "title": "Current card ownership",
            "kind": "tree",
            "type": "domain",
            "change": "existing",
            "source": "src/features/sessions/components/transcript/messages/tools/ToolCallMessage.tsx#ToolCallMessage",
            "roots": [
              {
                "name": "ToolCallMessage",
                "children": [
                  { "name": "Frame" },
                  { "name": "Status and disclosure" },
                  { "name": "Actions" },
                  { "name": "Tool-specific body" }
                ]
              }
            ]
          }
        },
        {
          "id": "finding-duplicate-bodies",
          "statement": "Shell commands and file reads each rebuild body presentation inside tool-specific components.",
          "whyItMatters": "They are concrete ordinary cases for one declared body vocabulary.",
          "sources": [
            "src/features/sessions/components/transcript/messages/tools/BashToolCall.tsx#BashToolCall",
            "src/features/sessions/components/transcript/messages/tools/ReadToolCall.tsx#ReadToolCall"
          ]
        },
        {
          "id": "finding-rich-diff",
          "statement": "File edits depend on a dedicated syntax-aware diff presentation.",
          "whyItMatters": "Consolidation must deliberately preserve that richness or keep the renderer specialized.",
          "sources": [
            "src/features/sessions/components/transcript/messages/tools/FileDiffToolCall.tsx#FileDiffToolCall"
          ]
        }
      ]
    },
    {
      "id": "direction",
      "title": "The idea",
      "purpose": "Explain how the shared body fits the existing card owner and where specialization remains.",
      "kind": "markdown",
      "collapsed": false,
      "body": "ToolCallMessage keeps owning the card frame, status, disclosure, and actions. An ordinary tool stops rebuilding that surrounding presentation and instead describes its body as text, code, or a rich diff for the card to render; only a genuinely different interaction or nesting model keeps a custom React path."
    },
    {
      "id": "ordinary-cases",
      "title": "Where it helps",
      "purpose": "Show how familiar results move onto the shared path while specialized results stay where they are.",
      "kind": "records",
      "collapsed": false,
      "view": "table",
      "sourcePolicy": "code",
      "subject": "Tool result",
      "fields": [
        {
          "id": "body",
          "label": "Shared body",
          "kind": "choice",
          "cardinality": "one",
          "options": [
            {
              "id": "text",
              "label": "Text"
            },
            {
              "id": "code",
              "label": "Code"
            },
            {
              "id": "diff",
              "label": "Rich diff"
            },
            {
              "id": "custom",
              "label": "Custom renderer"
            }
          ]
        },
        {
          "id": "result",
          "label": "What stays visible",
          "kind": "text"
        }
      ],
      "items": [
        {
          "id": "bash-result",
          "subject": "Shell commands",
          "change": "modified",
          "values": {
            "body": "code",
            "result": "The command and its output keep syntax-aware formatting inside the ordinary tool card."
          },
          "source": "src/features/sessions/components/transcript/messages/tools/BashToolCall.tsx#BashToolCall",
          "basedOn": ["finding-duplicate-bodies"]
        },
        {
          "id": "read-result",
          "subject": "File reads",
          "change": "modified",
          "values": {
            "body": "code",
            "result": "The path and returned source keep their current readable code presentation."
          },
          "source": "src/features/sessions/components/transcript/messages/tools/ReadToolCall.tsx#ReadToolCall",
          "basedOn": ["finding-duplicate-bodies"]
        },
        {
          "id": "special-results",
          "subject": "Unknown tools and recursive sub-agents",
          "change": "preserved",
          "values": {
            "body": "custom",
            "result": "Fallback JSON and nested activity keep their current specialized paths."
          },
          "source": "src/features/sessions/components/transcript/messages/tools/ToolCallMessage.tsx#ToolCallMessage",
          "basedOn": ["finding-card-owner"]
        }
      ]
    },
    {
      "id": "diff-choice",
      "title": "One choice",
      "purpose": "Settle whether a rich diff belongs in the shared body vocabulary or remains a structural exception.",
      "kind": "decisions",
      "collapsed": false,
      "items": [
        {
          "id": "diff-treatment",
          "question": "Should a rich diff count as ordinary shared content?",
          "options": [
            {
              "id": "shared-diff",
              "label": "Yes, a diff is another shared body kind",
              "rationale": "Edit results keep their syntax-aware presentation without needing a separate card structure.",
              "tradeoff": "The shared body renderer needs one richer content kind.",
              "adds": [
                {
                  "sectionId": "ordinary-cases",
                  "id": "edit-result",
                  "subject": "Edit results",
                  "change": "modified",
                  "values": {
                    "body": "diff",
                    "result": "Added and removed lines stay syntax-aware inside the ordinary tool card."
                  },
                  "source": "src/features/sessions/components/transcript/messages/tools/FileDiffToolCall.tsx#FileDiffToolCall"
                }
              ],
              "exhibit": {
                "id": "tool-body-type",
                "title": "Shared tool body",
                "kind": "pseudocode",
                "change": "new",
                "description": "This option makes a rich diff one portable body kind while ToolCallMessage keeps card ownership.",
                "language": "typescript",
                "content": "type ToolBody =\n  | { kind: \"text\"; value: string }\n  | { kind: \"code\"; language?: string; value: string }\n  | { kind: \"diff\"; value: FileDiff };\n",
                "basedOn": ["finding-card-owner", "finding-duplicate-bodies"]
              }
            },
            {
              "id": "custom-diff",
              "label": "No, keep a bespoke diff renderer",
              "rationale": "The current diff component remains completely independent.",
              "tradeoff": "Ordinary tool presentation stays split across more React components.",
              "adds": [
                {
                  "sectionId": "ordinary-cases",
                  "id": "custom-edit-result",
                  "subject": "Edit results",
                  "change": "preserved",
                  "values": {
                    "body": "custom",
                    "result": "The existing syntax-aware diff renderer remains a separate structural path."
                  },
                  "source": "src/features/sessions/components/transcript/messages/tools/FileDiffToolCall.tsx#FileDiffToolCall"
                }
              ],
              "exhibit": {
                "id": "custom-diff-renderer",
                "title": "Bespoke diff rendering",
                "kind": "pseudocode",
                "change": "preserved",
                "description": "This option keeps the diff outside the shared body vocabulary.",
                "source": "src/features/sessions/components/transcript/messages/tools/FileDiffToolCall.tsx#FileDiffToolCall",
                "language": "tsx",
                "content": "function renderEditResult(diff: FileDiff) {\n  return <FileDiffToolCall diff={diff} />;\n}\n",
                "basedOn": ["finding-rich-diff"]
              }
            }
          ],
          "choice": {
            "optionId": "shared-diff",
            "status": "decided"
          },
          "dependsOn": [],
          "affects": [
            "bash-result",
            "read-result",
            "special-results"
          ],
          "basedOn": ["finding-rich-diff"]
        }
      ]
    },
    {
