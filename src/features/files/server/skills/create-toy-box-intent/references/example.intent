{
  "title": "Let ordinary tools share message bodies",
  "sections": [
    {
      "id": "direction",
      "title": "The idea",
      "purpose": "Explain how the shared body fits the existing card owner and where specialization remains.",
      "kind": "prose",
      "collapsed": false,
      "body": "ToolCallMessage keeps owning the card frame, status, disclosure, and actions. An ordinary tool stops rebuilding that surrounding presentation and instead describes its body as text, code, or a rich diff for the card to render; only a genuinely different interaction or nesting model keeps a custom React path."
    },
    {
      "id": "ordinary-cases",
      "title": "Where it helps",
      "purpose": "Show how familiar results move onto the shared path while specialized results stay where they are.",
      "kind": "records",
      "collapsed": false,
      "view": "table",
      "provenance": "code",
      "subject": "Tool result",
      "fields": [
        {
          "id": "body",
          "label": "Shared body",
          "kind": "choice",
          "cardinality": "one",
          "options": [
            {
              "id": "text",
              "label": "Text"
            },
            {
              "id": "code",
              "label": "Code"
            },
            {
              "id": "diff",
              "label": "Rich diff"
            },
            {
              "id": "custom",
              "label": "Custom renderer"
            }
          ]
        },
        {
          "id": "result",
          "label": "What stays visible",
          "kind": "text"
        }
      ],
      "items": [
        {
          "id": "bash-result",
          "subject": "Shell commands",
          "change": "modified",
          "values": {
            "body": "code",
            "result": "The command and its output keep syntax-aware formatting inside the ordinary tool card."
          },
          "provenance": "src/features/sessions/components/transcript/messages/tools/BashToolCall.tsx#BashToolCall"
        },
        {
          "id": "read-result",
          "subject": "File reads",
          "change": "modified",
          "values": {
            "body": "code",
            "result": "The path and returned source keep their current readable code presentation."
          },
          "provenance": "src/features/sessions/components/transcript/messages/tools/ReadToolCall.tsx#ReadToolCall"
        },
        {
          "id": "special-results",
          "subject": "Unknown tools and recursive sub-agents",
          "change": "preserved",
          "values": {
            "body": "custom",
            "result": "Fallback JSON and nested activity keep their current specialized paths."
          },
          "provenance": "src/features/sessions/components/transcript/messages/tools/ToolCallMessage.tsx#ToolCallMessage"
        }
      ]
    },
    {
      "id": "diff-choice",
      "title": "One choice",
      "purpose": "Settle whether a rich diff belongs in the shared body vocabulary or remains a structural exception.",
      "kind": "decisions",
      "collapsed": false,
      "items": [
        {
          "id": "diff-treatment",
          "question": "Should a rich diff count as ordinary shared content?",
          "options": [
            {
              "id": "shared-diff",
              "label": "Yes, a diff is another shared body kind",
              "rationale": "Edit results keep their syntax-aware presentation without needing a separate card structure.",
              "tradeoff": "The shared body renderer needs one richer content kind.",
              "adds": [
                {
                  "sectionId": "ordinary-cases",
                  "id": "edit-result",
                  "subject": "Edit results",
                  "change": "modified",
                  "values": {
                    "body": "diff",
                    "result": "Added and removed lines stay syntax-aware inside the ordinary tool card."
                  },
                  "provenance": "src/features/sessions/components/transcript/messages/tools/FileDiffToolCall.tsx#FileDiffToolCall"
                }
              ],
              "relations": [
                {
                  "id": "edit-result-uses-tool-body",
                  "from": "edit-result",
                  "to": "tool-body-type",
                  "kind": "realized-by",
                  "label": "uses the same body shape"
                },
                {
                  "id": "edit-result-implemented-by-adapters",
                  "from": "edit-result",
                  "to": "move-ordinary-tools-work",
                  "kind": "implemented-by"
                }
              ]
            },
            {
              "id": "custom-diff",
              "label": "No, keep a bespoke diff renderer",
              "rationale": "The current diff component remains completely independent.",
              "tradeoff": "Ordinary tool presentation stays split across more React components.",
              "adds": [
                {
                  "sectionId": "ordinary-cases",
                  "id": "custom-edit-result",
                  "subject": "Edit results",
                  "change": "preserved",
                  "values": {
                    "body": "custom",
                    "result": "The existing syntax-aware diff renderer remains a separate structural path."
                  },
                  "provenance": "src/features/sessions/components/transcript/messages/tools/FileDiffToolCall.tsx#FileDiffToolCall"
                }
              ],
              "relations": []
            }
          ],
          "chosen": "shared-diff",
          "status": "decided",
          "blocking": true,
          "dependsOn": [],
          "affects": [
            "ordinary-cases",
            "tool-body-type"
          ]
        }
      ]
    },
    {
      "id": "exact-shape",
      "title": "The exact shape",
      "purpose": "Keep the small shared type beside the behavior it makes possible.",
      "kind": "exhibits",
      "collapsed": false,
      "provenance": "optional",
      "items": [
        {
          "id": "tool-body-type",
          "title": "Shared tool body",
          "kind": "code",
          "change": "new",
          "description": "Each ordinary result supplies content; ToolCallMessage still owns how it appears inside the existing card.",
          "language": "typescript",
          "content": "type ToolBody =\n  | { kind: \"text\"; value: string }\n  | { kind: \"code\"; language?: string; value: string }\n  | { kind: \"diff\"; value: FileDiff };\n"
        }
      ]
    },
    {
